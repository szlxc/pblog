# ============================================================
# PBLOG 环境变量模板
#
# 使用方法：
#   cp .env.example .env   然后按下面说明填写
#
# 重要：.env 含真实密钥，已在 .gitignore 中排除，切勿提交。
#       本文件（.env.example）会被提交到公开仓库，
#       因此这里只能放占位符，不要填任何真实密码。
# ============================================================

# ---------- 1. 站点地址 ----------
# 部署到域名时填写完整地址；本地调试可用 http://localhost
PBLOG_PUBLIC_URL=http://localhost
PBLOG_FRONTEND_URL=http://localhost
PBLOG_ADMIN_URL=http://localhost/admin

# ---------- 2. 对外端口 ----------
PBLOG_HTTP_PORT=8080

# ---------- 3. JWT 密钥 ----------
# 必须 32 位以上随机字符串。生成方法：
#   openssl rand -hex 32
PBLOG_JWT_SECRET=

# ---------- 4. MySQL ----------
# 首次启动会据此创建数据库；若已存在数据卷，请保持与当初一致
PBLOG_DB_ROOT_PASSWORD=
PBLOG_DB_NAME=pblog
PBLOG_DB_USER=pblog
PBLOG_DB_PASSWORD=

# ---------- 5. 管理员 ----------
# 仅在首次初始化数据库时用于创建管理员账号，
# 之后修改这里不会改变已有账号的密码。
PBLOG_ADMIN_USER=admin
PBLOG_ADMIN_PASSWORD=

# ---------- 6. 可选 ----------
# 邮件（SMTP）与 UAPI 等第三方配置建议在「管理端」填写，无需改这里
