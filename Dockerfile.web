# ---------- 前台 + 管理端：一次构建，Nginx 托管 ----------
FROM node:20-alpine AS build
WORKDIR /app

# 国内构建：换 alpine 源与 npm 源
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.ustc.edu.cn#g' /etc/apk/repositories \
 && npm config set registry https://registry.npmmirror.com

# 统一配置（构建时注入到前端产物）
COPY config ./config
COPY PBLOG.json ./PBLOG.json

COPY web/package.json ./web/package.json
COPY admin/package.json ./admin/package.json
RUN cd web && npm install --no-audit --no-fund && cd ../admin && npm install --no-audit --no-fund

COPY web ./web
COPY admin ./admin

# 浏览器访问后端的地址，由 docker-compose 的 build args 传入
ARG PBLOG_PUBLIC_URL=http://localhost
ENV PBLOG_PUBLIC_URL=${PBLOG_PUBLIC_URL}
RUN cd web && npm run build && cd ../admin && npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html
COPY --from=build /app/admin/dist /usr/share/nginx/html/admin
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
